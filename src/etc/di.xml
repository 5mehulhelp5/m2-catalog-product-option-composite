<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- the observer runs before every model is saved, it needs the product helper only for custom options -->
    <type name="Infrangible\CatalogProductOptionComposite\Observer\ModelSaveBefore">
        <arguments>
            <argument name="productHelper" xsi:type="object">Infrangible\Core\Helper\Product\Proxy</argument>
        </arguments>
    </type>
</config>
