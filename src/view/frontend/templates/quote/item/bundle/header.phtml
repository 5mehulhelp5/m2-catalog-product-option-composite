use Infrangible\CatalogProductOptionComposite\Block\Quote\Item\Bundle;
use Infrangible\CatalogProductOptionComposite\ViewModel\ProductAttribute;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var Bundle $block */

/** @var ProductAttribute $productAttribute */
$productAttribute = $block->getData('product_attribute');
$product = $block->getProduct();
$subline = $product->getData('quote_item_bundle_subline');
$description = $product->getData('quote_item_bundle_description');
?>
<?php if (is_string($subline) && $subline !== ''): ?>
    <h2><?= $escaper->escapeHtml($subline) ?></h2>
<?php endif; ?>
<?php if (is_string($description) && $description !== ''): ?>
    <div class="description">
        <?= /* @noEscape */ $productAttribute->render($product, $description, 'quote_item_bundle_description') ?>
    </div>
<?php endif; ?>
