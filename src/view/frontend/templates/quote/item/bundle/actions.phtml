use Infrangible\CatalogProductOptionComposite\Block\Quote\Item\Bundle;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var Bundle $block */

$product = $block->getProduct();
$backButtonText = $product->getData('quote_item_bundle_back_button_text');
$backButtonText = is_string($backButtonText) && $backButtonText !== '' ? $backButtonText : __('Go Back');
$updateButtonText = $product->getData('quote_item_bundle_update_button_text');
$updateButtonText = is_string($updateButtonText) && $updateButtonText !== '' ? $updateButtonText :
    __('Update Shopping Cart');
?>
<a class="action secondary back"
   href="<?= $escaper->escapeUrl($block->getUrl('checkout/cart')) ?>"
   title="<?= $escaper->escapeHtmlAttr($backButtonText) ?>">
    <span><?= $escaper->escapeHtml($backButtonText) ?></span>
</a>
<button type="submit"
        name="update_cart_action"
        value="update_qty"
        title="<?= $escaper->escapeHtmlAttr($updateButtonText) ?>"
        class="action primary update">
    <span><?= $escaper->escapeHtml($updateButtonText) ?></span>
</button>
