use Infrangible\CatalogProductOptionComposite\Block\Quote\Item\Bundle\Products\Selection\Options;
use Magento\Framework\Escaper;
use Magento\Framework\View\TemplateEngine\Php;

/** @var Php $this */
/** @var Escaper $escaper */
/** @var Options $block */

$bundleOption = $block->getBundleOption();
$product = $block->getProduct();
$options = $block->getOptions();
$key = sprintf('%d-%d', $bundleOption->getId(), $product->getId());
$priceBoxSelector = sprintf("[data-price-box-id='quote-item-bundle-selection-id-%s'][data-role=priceBox]", $key);
?>

<?php if ($options): ?>
    <script type="text/x-magento-init">
        {
            "#quote-item-bundle-selection-<?= /* @noEscape */ $key ?>": {
                "priceOptions": {
                    "optionConfig": <?= /* @noEscape */ $block->getJsonConfig(); ?>,
                    "controlContainer": ".field",
                    "priceHolderSelector": "<?= /* @noEscape */ $priceBoxSelector ?>"
                }
            }
        }
    </script>
    <div class="product-options-wrapper quote-item-bundle-selection-options-wrapper"
         id="quote-item-bundle-selection-options-wrapper-<?= /* @noEscape */ $key ?>">
        <div class="fieldset">
            <?php foreach ($options as $option): ?>
                <?= $block->getBundleOptionHtml($bundleOption, $product, $option) ?>
            <?php endforeach; ?>
        </div>
    </div>
    <div class="product-options-price">
        <div class="price-box"
             data-role="priceBox"
             data-price-box-id="quote-item-bundle-selection-id-<?= /* @noEscape */ $key ?>">
            <?= /* @noEscape */ $block->renderAmount(
                [
                    'price_id'          => 'quote-item-bundle-selection-price-' . $key,
                    'price_type'        => 'finalPrice',
                    'include_container' => true,
                    'schema'            => 'item_view'
                ]
            ) ?>
        </div>
        <script type="text/x-magento-init">
            {
                "[data-role=priceBox][data-price-box-id=quote-item-bundle-selection-id-<?= /* @noEscape */ $key ?>]": {
                    "priceBox": {
                        "priceConfig": {
                            "priceFormat": <?= /* @noEscape */ $block->getPriceFormatJson() ?>,
                            "prices": <?= /* @noEscape */ $block->getPricesJson() ?>
                        }
                    }
                }
            }
        </script>
    </div>
<?php endif; ?>
