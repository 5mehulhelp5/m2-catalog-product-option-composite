use Infrangible\CatalogProductOptionComposite\Block\Quote\Item\Bundle\Products\Selection\Options\Type\Select;
use Magento\Catalog\Api\Data\ProductCustomOptionInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\TemplateEngine\Php;

/** @var Php $this */
/** @var Escaper $escaper */
/** @var Select $block */

$option = $block->getOption();
$class = $option->getIsRequire() ? ' required' : '';
$hasContainer = $option->getType() == ProductCustomOptionInterface::OPTION_TYPE_RADIO ||
    $option->getType() == ProductCustomOptionInterface::OPTION_TYPE_CHECKBOX;
$item = $block->getItem();
$valuesHtml = $block->getValuesHtml();
$itemId = $escaper->escapeHtmlAttr($item->getId());
$optionId = $escaper->escapeHtmlAttr($option->getId());
$containerId = sprintf('item-%s-options-%s-container', $itemId, $optionId);
?>

<?php if ($valuesHtml): ?>
    <div class="field<?= /* @noEscape */ $class ?>">
        <label class="label" for="cart_<?= /* @noEscape */ $itemId ?>_select_<?= /* @noEscape */ $optionId ?>">
            <span><?= $escaper->escapeHtml($option->getTitle()); ?></span>
        </label>
        <div class="control">
            <?= /* @noEscape */ $valuesHtml ?>
            <?php if ($option->getIsRequire()): ?>
                <?php if ($hasContainer):?>
                    <span id="<?= /* @noEscape */ $containerId ?>"></span>
                <?php endif; ?>
            <?php endif;?>
        </div>
    </div>
<?php endif; ?>
