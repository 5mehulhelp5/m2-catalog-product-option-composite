use Infrangible\CatalogProductOptionComposite\Block\Quote\Item\Bundle\Products\Selection\Options\Type\Select\Checkable;
use Magento\Catalog\Api\Data\ProductCustomOptionInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Helper\SecureHtmlRenderer;

/** @var Escaper $escaper */
/** @var SecureHtmlRenderer $secureRenderer */
/** @var Checkable $block */

$option = $block->getOption();
$item = $block->getItem();
$configValue = $block->getPreconfiguredValue($option);
$optionType = $option->getType();
$isCheckbox = $optionType === ProductCustomOptionInterface::OPTION_TYPE_CHECKBOX;
$name = sprintf('cart[%s][options][%s]', $item->getId(), $option->getId());
$idPrefix = sprintf('cart_%s_options_%s', $item->getId(), $option->getId());
$listId = sprintf('cart-%s-options-%s-list', $item->getId(), $option->getId());
$inputClass = ($isCheckbox ? 'checkbox admin__control-checkbox' : 'radio admin__control-radio') .
    ($option->getIsRequire() ? ' required' : '') . ' product-custom-option';
$count = 1;
?>
<div class="options-list nested" id="<?= $escaper->escapeHtmlAttr($listId) ?>">
    <?php if ($optionType === ProductCustomOptionInterface::OPTION_TYPE_RADIO && ! $option->getIsRequire()): ?>
        <div class="field choice admin__field admin__field-option">
            <input type="radio"
                   id="<?= $escaper->escapeHtmlAttr($idPrefix) ?>"
                   class="radio admin__control-radio product-custom-option"
                   name="<?= $escaper->escapeHtmlAttr($name) ?>"
                   data-selector="<?= $escaper->escapeHtmlAttr($name) ?>"
                   value=""
                   checked="checked"
            />
            <?php if (! $block->getSkipJsReloadPrice()): ?>
                <?= /* @noEscape */ $secureRenderer->renderEventListenerAsTag(
                    'onclick',
                    'opConfig.reloadPrice()',
                    '#' . $idPrefix
                ) ?>
            <?php endif; ?>
            <label class="label admin__field-label" for="<?= $escaper->escapeHtmlAttr($idPrefix) ?>">
                <span><?= $escaper->escapeHtml(__('None')) ?></span>
            </label>
        </div>
    <?php endif; ?>
    <?php foreach ($block->getAvailableValues() as $value): ?>
        <?php
        $count++;
        $valueId = $value->getOptionTypeId();
        $checked = $isCheckbox ?
            is_array($configValue) && in_array($valueId, $configValue) :
            $configValue == $valueId;
        $inputId = $idPrefix . '_' . $count;
        $dataSelector = $name . ($isCheckbox ? '[' . $valueId . ']' : '');
        ?>
        <div class="field choice admin__field admin__field-option">
            <input type="<?= $escaper->escapeHtmlAttr($optionType) ?>"
                   class="<?= /* @noEscape */ $inputClass ?>"
                   name="<?= $escaper->escapeHtmlAttr($name . ($isCheckbox ? '[]' : '')) ?>"
                   id="<?= $escaper->escapeHtmlAttr($inputId) ?>"
                   value="<?= $escaper->escapeHtmlAttr($valueId) ?>"
                   <?= /* @noEscape */ $checked ? 'checked="checked"' : '' ?>
                   data-selector="<?= $escaper->escapeHtmlAttr($dataSelector) ?>"
                   data-price="<?= $escaper->escapeHtmlAttr($block->getCurrencyByStore($value)) ?>"
            />
            <?php if (! $block->getSkipJsReloadPrice()): ?>
                <?= /* @noEscape */ $secureRenderer->renderEventListenerAsTag(
                    'onclick',
                    'opConfig.reloadPrice()',
                    '#' . $inputId
                ) ?>
            <?php endif; ?>
            <label class="label admin__field-label" for="<?= $escaper->escapeHtmlAttr($inputId) ?>">
                <span><?= $escaper->escapeHtml($value->getTitle()) ?></span>
                <?= /* @noEscape */ $block->formatPrice($value) ?>
            </label>
        </div>
    <?php endforeach; ?>
</div>
