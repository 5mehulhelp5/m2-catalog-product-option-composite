use Infrangible\CatalogProductOptionComposite\Block\Quote\Item\Bundle\Products\Selection;
use Infrangible\CatalogProductOptionComposite\ViewModel\ProductAttribute;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var Selection $block */

/** @var ProductAttribute $productAttribute */
$productAttribute = $block->getData('product_attribute');
$bundleOption = $block->getBundleOption();
$product = $block->getProduct();
$key = sprintf('%d-%d', $bundleOption->getId(), $product->getId());
?>
<li class="item product product-item quote-item-bundle-selection"
    id="quote-item-bundle-selection-<?= $escaper->escapeHtmlAttr($key) ?>">
    <div class="product-item-info"
         id="quote-item-bundle-selection-product-item-info-<?= $escaper->escapeHtmlAttr($key) ?>"
         data-container="product-grid">
        <?= $block->getImage($product, 'category_page_grid')->toHtml() ?>
        <div class="product details product-item-details">
            <strong class="product name product-item-name">
                <?= /* @noEscape */ $productAttribute->render($product, (string)$product->getName(), 'name') ?>
            </strong>
            <?= /* @noEscape */ $block->getProductPrice($product) ?>
            <?= $block->getOptionsHtml($bundleOption, $product) ?>
        </div>
    </div>
</li>
