use Infrangible\CatalogProductOptionComposite\Block\Product\View\Options\Composite\Bundle;
use Magento\Framework\Escaper;
use Magento\Framework\View\TemplateEngine\Php;

/** @var Php $this */
/** @var Escaper $escaper */
/** @var Bundle $block */

$bundleOption = $block->getBundleOption();
$bundleOptionId = (int)$bundleOption->getId();
?>

<script type="text/x-magento-init">
    {
        "#bundle-option-<?= /* @noEscape */ $bundleOptionId ?>": {
            "priceOptions": {
                "optionConfig": <?= /* @noEscape */ $block->getOptionsJsonConfig() ?>,
                "controlContainer": ".field",
                "priceHolderSelector":
                    "[data-role=priceBox][data-price-box-id=bundle-selection-id-<?= /* @noEscape */ $bundleOptionId ?>]"
            }
        }
    }
</script>

<div class="product-options-price">
    <div class="price-box"
         data-role="priceBox"
         data-price-box-id="bundle-selection-id-<?= /* @noEscape */ $bundleOptionId ?>">
        <?= /* @noEscape */ $block->renderAmount(
            [
                'display_label'     => __('Selected product options'),
                'price_id'          => 'bundle-selection-price-' . $bundleOptionId,
                'price_type'        => 'finalPrice',
                'include_container' => true,
                'schema'            => 'item_view'
            ]
        ) ?>
    </div>
    <script type="text/x-magento-init">
        {
            "[data-role=priceBox][data-price-box-id=bundle-selection-id-<?= /* @noEscape */ $bundleOptionId ?>]": {
                "priceBox": {
                    "priceConfig": {
                        "priceFormat": <?= /* @noEscape */ $block->getPriceFormatJson() ?>,
                        "prices": <?= /* @noEscape */ $block->getPricesJson() ?>
                    }
                }
            }
        }
    </script>
</div>
